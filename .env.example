# Copy to `.env` and fill in what you need. `.env` is gitignored; never commit it.
#
# Always run with the `env -u` prefix so this file wins over stale shell exports:
#
#   env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL \
#       -u OPENAI_API_KEY -u OPENAI_BASE_URL -u CODEX_HOME -u CLAUDE_CONFIG_DIR \
#       uv run --env-file .env --locked assembly-world-agent run ...

# --- Claude Code ---

# Anthropic API key. Takes precedence over the subscription login.
# Leave empty to use the subscription login in CLAUDE_CONFIG_DIR.
ANTHROPIC_API_KEY=

# Claude Code config and credential directory. One directory per identity;
# run `CLAUDE_CONFIG_DIR=<dir> claude auth login` once for each.
CLAUDE_CONFIG_DIR=

# Bearer token. Ranks above ANTHROPIC_API_KEY. Unused here.
# ANTHROPIC_AUTH_TOKEN=

# Anthropic API base URL. Unused here; official endpoint only.
# ANTHROPIC_BASE_URL=

# --- Codex ---

# Codex config and credential directory. The only working identity switch,
# because `auth.json` holds one auth mode at a time. One directory per identity:
#   CODEX_HOME=$HOME/.codex-awa-sub codex login
#   printenv OPENAI_API_KEY | CODEX_HOME=$HOME/.codex-awa-api codex login --with-api-key
CODEX_HOME=

# OpenAI API key. Only for the one-time `codex login --with-api-key` above.
# OPENAI_API_KEY=

# OpenAI API base URL. Verified to have no effect under a ChatGPT login;
# third-party endpoints need a code change.
# OPENAI_BASE_URL=
